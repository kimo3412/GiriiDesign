# ==========================================
# 独立设计师工作室生产流程管理系统 - Git 忽略规则
# ==========================================

# ==================== IDE ====================
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.project
.classpath

# ==================== OS ====================
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# ==================== 后端 (Java/Maven) ====================
Code/target/
Code/*.jar
Code/*.war
Code/*.class
Code/.mvn/wrapper/maven-wrapper.jar
Code/mvnw
Code/mvnw.cmd

# ==================== 前端 (Node/Vite) ====================
node_modules/
package.json
package-lock.json
web-admin/node_modules/
web-admin/dist/
web-admin/.cache/
web-admin/.temp/
web-admin/*.local
web-admin/.env.production

# ==================== 小程序 (Uni-app) ====================
mini-app/node_modules/
mini-app/dist/
mini-app/unpackage/
mini-app/.cache/
mini-app/.temp/
mini-app/*.local
mini-app/.env

# 微信开发者工具
mini-app/project.config.json
mini-app/project.private.config.json
mini-app/package-lock.json

# ==================== 日志 ====================
*.log
logs/

# ==================== 上传文件 ====================
uploads/

# ==================== 临时测试文件 ====================
_tmp_*
__pycache__/

