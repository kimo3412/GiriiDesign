# 只在开发模式中被载入
VITE_PORT = 3100

# 网站根目录
VITE_PUBLIC_PATH = /

# 关闭 mock（使用真实后端 API）
VITE_USE_MOCK = false

# 不打印 mock 信息
VITE_LOGGER_MOCK = false

# 保留 console 日志（开发阶段）
VITE_DROP_CONSOLE = false

# 跨域代理 → 后端 Spring Boot 8081
VITE_PROXY = [["/api", "http://localhost:8081/api"]]

# API 接口地址
VITE_GLOB_API_URL =

# 接口前缀
VITE_GLOB_API_URL_PREFIX = /api

# 文件上传地址
VITE_GLOB_UPLOAD_URL = /api/v1/oss/upload

# 文件访问前缀（Nginx 静态代理）
VITE_GLOB_FILE_URL = http://localhost:8081
